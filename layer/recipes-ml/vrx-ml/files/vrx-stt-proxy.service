# Forwards the socket's connections to whisper-server on 127.0.0.1:8082
# inside the server's network namespace (JoinsNamespaceOf): the TCP port
# exists only there, so the socket is the one way in (G024). The pattern
# is systemd-socket-proxyd(8)'s own example.
[Unit]
Description=vrx local speech model (proxy)
Requires=vrx-stt.socket
# bound to its server: a server that dies (killed, OOM) takes the proxy
# with it, so the next connection on the socket starts both again; with
# Requires= the proxy lived on and refused every question (bench,
# 2026-10-14)
BindsTo=vrx-stt-server.service
After=vrx-stt.socket vrx-stt-server.service
JoinsNamespaceOf=vrx-stt-server.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=120s 127.0.0.1:8082
PrivateNetwork=yes
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
