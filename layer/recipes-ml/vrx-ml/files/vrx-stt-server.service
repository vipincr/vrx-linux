# whisper-server with the speech model (plan 0011 D18). It listens on
# 127.0.0.1:8082 in a network namespace of its own (PrivateNetwork=yes,
# checked by vrx-image's G024 rule); only vrx-stt-proxy joins it. Started
# with the proxy, stopped when the proxy is: StopWhenUnneeded frees the
# model's ~100 MB two minutes after the last request. The kernel ends it
# before the UI when memory runs out (OOMScoreAdjust), and its budget
# leaves the applets theirs (MemoryHigh/MemoryMax).
[Unit]
Description=vrx local speech model (whisper-server)
StopWhenUnneeded=yes
# full CPU speed for exactly this server's lifetime (plan 0012 D1)
Wants=vrx-ml-speed.service
After=vrx-ml-speed.service
# the speech model's recipe installs this link (meta-vrx, VRX_ML_MODELS); an
# image without a speech model ships no unit, and a missing file never starts
ConditionPathExists=/usr/share/vrx-ml/speech.bin

[Service]
Type=exec
ExecStart=/usr/bin/whisper-server --host 127.0.0.1 --port 8082 \
    --model /usr/share/vrx-ml/speech.bin --threads 3
# whisper-server loads the model before it listens; its form page at /
# answers once it does
ExecStartPost=/usr/libexec/vrx/vrx-ml-ready 8082 /
TimeoutStartSec=90
PrivateNetwork=yes
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryHigh=200M
MemoryMax=250M
OOMScoreAdjust=500
# The screen comes first (bench, CM4, 2026-10-14: with --threads 4 on the
# four A72 cores an applet missed its 5 s start budget while the model
# answered). Three threads leave a core for the compositor and the
# applets, and the scheduler favours them for the rest: CPUWeight 20
# against the default 100, Nice 10, and IOWeight 20 against 100 for
# reading the model off the eMMC.
CPUWeight=20
Nice=10
IOWeight=20
