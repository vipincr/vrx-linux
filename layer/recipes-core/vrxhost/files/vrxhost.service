[Unit]
Description=vrx applet OS daemon (registry, trail, focus, io.vrx.Host)
After=systemd-journald.service systemd-tmpfiles-setup.service dbus.service
# vrxinit (plan 0007 part M) replaces this ordering when it lands;
# until then vrxhost starts after the hardware services, before the
# UI would if it were enabled
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/vrxhost
Restart=on-failure
RestartSec=2
# The runtime directory /run/vrx comes from tmpfiles.d (root:vrx 2750).
# UMask 0007 makes the io.vrx.Host socket 0770: group vrx (every applet)
# connects, nobody else.
UMask=0007
# Plan 0008 D1: applets are systemd units, so vrxhost needs no
# capability at all. It asks systemd (as root, which systemd's own
# authorization accepts) to start units and reads their state.
# CAP_SYS_PTRACE, and nothing else: reading another user's
# /proc/<pid>/fd and fdinfo needs it (ptrace read access). The energy
# sampler reads each applet's GPU client there (plan 0012 D8) and the
# freezer the channel ends an applet holds (D2); without it both read
# nothing, silently.
CapabilityBoundingSet=CAP_SYS_PTRACE
# io.vrx.Matter (plan 0015 D9): vrxhost connects to vrx-matter's socket
# (/run/vrx-matter, group vrx-matter) as root without CAP_DAC_OVERRIDE, so
# through the group; vrx-policy makes it on every image
SupplementaryGroups=vrx-matter
NoNewPrivileges=yes
ProtectSystem=strict
# /data/vrx/energy: the hourly energy summaries (plan 0012 D9); absent
# on a board with no /data
ReadWritePaths=/run/vrx -/data/vrx/energy -/data/vrx/update -/data/vrx/updates
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK: the kernel's uevents, for power-supply changes (plan 0011 D12)
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# vrxhost connects to the compositor's socket (/run/vrx-ui/vrx.sock) as
# its controller and retries until it is up, so no ordering against
# vrx-ui.service is needed.

[Install]
WantedBy=multi-user.target
